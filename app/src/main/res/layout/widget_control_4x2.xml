<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_4x2_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_card_bg"
    android:orientation="horizontal"
    android:padding="10dp">

    <!-- Left Panel: Device State & List (Weight 4.2) -->
    <FrameLayout
        android:id="@+id/layout_left_panel"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="4.2">

        <!-- Case 1: Disconnected State - Display Top 3 Recent Devices List -->
        <LinearLayout
            android:id="@+id/layout_disconnected_panel_4x2"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:visibility="visible">

            <!-- Header -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@mipmap/ic_launcher_round"
                    android:contentDescription="Icon" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="5dp"
                    android:text="ADB 助手"
                    android:textColor="@color/widget_text_primary"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <!-- Status Dot & Text for Disconnected / Connecting state -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="end|center_vertical">

                    <ImageView
                        android:id="@+id/iv_status_dot_disconnected_4x2"
                        android:layout_width="6dp"
                        android:layout_height="6dp"
                        android:src="@drawable/widget_status_dot_disconnected"
                        android:contentDescription="Status Dot" />

                    <TextView
                        android:id="@+id/tv_status_text_disconnected_4x2"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="3dp"
                        android:text="未连接"
                        android:textColor="@color/widget_text_secondary"
                        android:textSize="9sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- Device Item 1 -->
            <LinearLayout
                android:id="@+id/item_dev_1_4x2"
                android:layout_width="match_parent"
                android:layout_height="22dp"
                android:layout_marginTop="3dp"
                android:background="@drawable/widget_item_bg"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="6dp">

                <ImageView
                    android:layout_width="5dp"
                    android:layout_height="5dp"
                    android:src="@drawable/widget_status_dot_disconnected"
                    android:contentDescription="Dot" />

                <TextView
                    android:id="@+id/tv_dev_name_1_4x2"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="5dp"
                    android:text="暂无历史设备"
                    android:textColor="@color/widget_text_primary"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:singleLine="true"
                    android:ellipsize="end" />

                <TextView
                    android:id="@+id/tv_dev_ip_1_4x2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minWidth="28dp"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:singleLine="true"
                    android:maxLines="1"
                    android:ellipsize="none"
                    android:text="点击连接"
                    android:textColor="@color/widget_accent"
                    android:textSize="9sp" />
            </LinearLayout>

            <!-- Device Item 2 -->
            <LinearLayout
                android:id="@+id/item_dev_2_4x2"
                android:layout_width="match_parent"
                android:layout_height="22dp"
                android:layout_marginTop="2dp"
                android:background="@drawable/widget_item_bg"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="6dp">

                <ImageView
                    android:layout_width="5dp"
                    android:layout_height="5dp"
                    android:src="@drawable/widget_status_dot_disconnected"
                    android:contentDescription="Dot" />

                <TextView
                    android:id="@+id/tv_dev_name_2_4x2"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="5dp"
                    android:text="扫描局域网设备"
                    android:textColor="@color/widget_text_secondary"
                    android:textSize="10sp"
                    android:singleLine="true"
                    android:ellipsize="end" />

                <TextView
                    android:id="@+id/tv_dev_ip_2_4x2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minWidth="28dp"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:singleLine="true"
                    android:maxLines="1"
                    android:ellipsize="none"
                    android:text="添加"
                    android:textColor="@color/widget_accent"
                    android:textSize="9sp" />
            </LinearLayout>

            <!-- Device Item 3 -->
            <LinearLayout
                android:id="@+id/item_dev_3_4x2"
                android:layout_width="match_parent"
                android:layout_height="22dp"
                android:layout_marginTop="2dp"
                android:background="@drawable/widget_item_bg"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="6dp">

                <ImageView
                    android:layout_width="5dp"
                    android:layout_height="5dp"
                    android:src="@drawable/widget_status_dot_disconnected"
                    android:contentDescription="Dot" />

                <TextView
                    android:id="@+id/tv_dev_name_3_4x2"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="5dp"
                    android:text="配对与调试指南"
                    android:textColor="@color/widget_text_secondary"
                    android:textSize="10sp"
                    android:singleLine="true"
                    android:ellipsize="end" />

                <TextView
                    android:id="@+id/tv_dev_ip_3_4x2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minWidth="28dp"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:singleLine="true"
                    android:maxLines="1"
                    android:ellipsize="none"
                    android:text="查看"
                    android:textColor="@color/widget_accent"
                    android:textSize="9sp" />
            </LinearLayout>

            <!-- Device Item 4 -->
            <LinearLayout
                android:id="@+id/item_dev_4_4x2"
                android:layout_width="match_parent"
                android:layout_height="22dp"
                android:layout_marginTop="2dp"
                android:background="@drawable/widget_item_bg"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="6dp">

                <ImageView
                    android:layout_width="5dp"
                    android:layout_height="5dp"
                    android:src="@drawable/widget_status_dot_disconnected"
                    android:contentDescription="Dot" />

                <TextView
                    android:id="@+id/tv_dev_name_4_4x2"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="5dp"
                    android:text="快速添加设备"
                    android:textColor="@color/widget_text_secondary"
                    android:textSize="10sp"
                    android:singleLine="true"
                    android:ellipsize="end" />

                <TextView
                    android:id="@+id/tv_dev_ip_4_4x2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minWidth="28dp"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:singleLine="true"
                    android:maxLines="1"
                    android:ellipsize="none"
                    android:text="添加"
                    android:textColor="@color/widget_accent"
                    android:textSize="9sp" />
            </LinearLayout>

            <!-- Device Item 5 -->
            <LinearLayout
                android:id="@+id/item_dev_5_4x2"
                android:layout_width="match_parent"
                android:layout_height="22dp"
                android:layout_marginTop="2dp"
                android:background="@drawable/widget_item_bg"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="6dp">

                <ImageView
                    android:layout_width="5dp"
                    android:layout_height="5dp"
                    android:src="@drawable/widget_status_dot_disconnected"
                    android:contentDescription="Dot" />

                <TextView
                    android:id="@+id/tv_dev_name_5_4x2"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="5dp"
                    android:text="打开控制中心"
                    android:textColor="@color/widget_text_secondary"
                    android:textSize="10sp"
                    android:singleLine="true"
                    android:ellipsize="end" />

                <TextView
                    android:id="@+id/tv_dev_ip_5_4x2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minWidth="28dp"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:singleLine="true"
                    android:maxLines="1"
                    android:ellipsize="none"
                    android:text="进入"
                    android:textColor="@color/widget_accent"
                    android:textSize="9sp" />
            </LinearLayout>

        </LinearLayout>

        <!-- Case 2: Connected State - Display Active Device & Session Info -->
        <LinearLayout
            android:id="@+id/layout_connected_panel_4x2"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:visibility="gone">

            <!-- App Header & Status -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@mipmap/ic_launcher_round"
                    android:contentDescription="App Icon" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="5dp"
                    android:text="ADB 控制台"
                    android:textColor="@color/widget_text_primary"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <!-- Status Dot & Text -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="end|center_vertical">

                    <ImageView
                        android:id="@+id/iv_status_dot_4x2"
                        android:layout_width="7dp"
                        android:layout_height="7dp"
                        android:src="@drawable/widget_status_dot_connected"
                        android:contentDescription="Status" />

                    <TextView
                        android:id="@+id/tv_status_text_4x2"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:text="已连接"
                        android:textColor="@color/widget_status_connected"
                        android:textSize="10sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>

            <!-- Active Device Info (Clickable to open connected device) -->
            <LinearLayout
                android:id="@+id/layout_device_info_4x2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/widget_item_bg"
                android:clickable="true"
                android:focusable="true"
                android:orientation="vertical"
                android:paddingHorizontal="6dp"
                android:paddingVertical="4dp">

                <TextView
                    android:id="@+id/tv_device_name_4x2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="已连接设备"
                    android:textColor="@color/widget_text_primary"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:singleLine="true"
                    android:ellipsize="end" />

                <TextView
                    android:id="@+id/tv_device_ip_4x2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:text="192.168.1.100:5555"
                    android:textColor="@color/widget_text_secondary"
                    android:textSize="10sp"
                    android:singleLine="true"
                    android:ellipsize="end" />
            </LinearLayout>

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <!-- Disconnect Button -->
            <LinearLayout
                android:id="@+id/btn_disconnect_4x2"
                android:layout_width="match_parent"
                android:layout_height="26dp"
                android:background="@drawable/widget_danger_btn_bg"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:src="@drawable/ic_widget_disconnect"
                    android:contentDescription="断开连接" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:text="断开连接"
                    android:textColor="@color/widget_danger"
                    android:textSize="10sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>

    <!-- Subtle Center Divider -->
    <ImageView
        android:layout_width="1dp"
        android:layout_height="match_parent"
        android:layout_marginHorizontal="8dp"
        android:layout_marginVertical="2dp"
        android:background="@color/widget_card_stroke"
        android:contentDescription="@null" />

    <!-- Right Panel (Weight 5.8): Disconnected LAN Scan Panel OR Connected 4 Action Tiles -->
    <FrameLayout
        android:id="@+id/layout_right_panel"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="5.8">

        <!-- Case 1: Disconnected State - LAN Device Scanning Panel -->
        <LinearLayout
            android:id="@+id/layout_disconnected_scan_4x2"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:background="@drawable/widget_tile_bg"
            android:padding="8dp"
            android:visibility="visible">

            <!-- Scan Header -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <ImageView
                    android:id="@+id/iv_scan_header_icon"
                    android:layout_width="15dp"
                    android:layout_height="15dp"
                    android:src="@drawable/ic_widget_refresh"
                    android:contentDescription="Scan Icon" />

                <TextView
                    android:id="@+id/tv_scan_header_title"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="4dp"
                    android:text="局域网扫描"
                    android:textColor="@color/widget_text_primary"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_scan_header_badge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/widget_item_bg"
                    android:paddingHorizontal="4dp"
                    android:paddingVertical="1dp"
                    android:text="5555端口"
                    android:textColor="@color/widget_accent"
                    android:textSize="8sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Description / Hint -->
            <TextView
                android:id="@+id/tv_scan_header_desc"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="探测当前 Wi-Fi 网段内所有开启无线调试的设备"
                android:textColor="@color/widget_text_secondary"
                android:textSize="9sp"
                android:singleLine="true"
                android:ellipsize="end" />

            <!-- Subview 1: Idle / Scanning State Body -->
            <LinearLayout
                android:id="@+id/layout_scan_idle_4x2"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:orientation="vertical"
                android:visibility="visible">

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1" />

                <!-- Buttons Row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <!-- Primary LAN Scan Button -->
                    <LinearLayout
                        android:id="@+id/btn_scan_lan_4x2"
                        android:layout_width="0dp"
                        android:layout_height="28dp"
                        android:layout_weight="1"
                        android:background="@drawable/widget_primary_btn_bg"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:orientation="horizontal"
                        android:paddingHorizontal="6dp">

                        <ImageView
                            android:id="@+id/iv_scan_btn_icon"
                            android:layout_width="12dp"
                            android:layout_height="12dp"
                            android:src="@drawable/ic_widget_scan"
                            android:contentDescription="Scan" />

                        <TextView
                            android:id="@+id/tv_scan_btn_text"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="4dp"
                            android:text="开始扫描"
                            android:textColor="@color/widget_white"
                            android:textSize="10sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <!-- Wireless Pair / Add Button -->
                    <LinearLayout
                        android:id="@+id/btn_pair_device_4x2"
                        android:layout_width="wrap_content"
                        android:layout_height="28dp"
                        android:layout_marginStart="6dp"
                        android:background="@drawable/widget_item_bg"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:orientation="horizontal"
                        android:paddingHorizontal="8dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="配对新设备"
                            android:textColor="@color/widget_text_secondary"
                            android:textSize="9sp" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <!-- Subview 2: Scan Results State Body (Discovered Devices List) -->
            <LinearLayout
                android:id="@+id/layout_scan_results_4x2"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:orientation="vertical"
                android:visibility="gone">

                <!-- Scanned Device Item 1 -->
                <LinearLayout
                    android:id="@+id/item_scanned_1_4x2"
                    android:layout_width="match_parent"
                    android:layout_height="22dp"
                    android:layout_marginTop="2dp"
                    android:background="@drawable/widget_item_bg"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="6dp">

                    <ImageView
                        android:layout_width="5dp"
                        android:layout_height="5dp"
                        android:src="@drawable/widget_status_dot_connected"
                        android:contentDescription="Online" />

                    <TextView
                        android:id="@+id/tv_scanned_name_1_4x2"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="5dp"
                        android:text="192.168.1.100:5555"
                        android:textColor="@color/widget_text_primary"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:singleLine="true"
                        android:ellipsize="end" />

                    <TextView
                        android:id="@+id/tv_scanned_action_1_4x2"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:minWidth="28dp"
                        android:gravity="center"
                        android:includeFontPadding="false"
                        android:text="连接"
                        android:textColor="@color/widget_accent"
                        android:textSize="9sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- Scanned Device Item 2 -->
                <LinearLayout
                    android:id="@+id/item_scanned_2_4x2"
                    android:layout_width="match_parent"
                    android:layout_height="22dp"
                    android:layout_marginTop="2dp"
                    android:background="@drawable/widget_item_bg"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="6dp">

                    <ImageView
                        android:layout_width="5dp"
                        android:layout_height="5dp"
                        android:src="@drawable/widget_status_dot_connected"
                        android:contentDescription="Online" />

                    <TextView
                        android:id="@+id/tv_scanned_name_2_4x2"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="5dp"
                        android:text="192.168.1.101:5555"
                        android:textColor="@color/widget_text_primary"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:singleLine="true"
                        android:ellipsize="end" />

                    <TextView
                        android:id="@+id/tv_scanned_action_2_4x2"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:minWidth="28dp"
                        android:gravity="center"
                        android:includeFontPadding="false"
                        android:text="连接"
                        android:textColor="@color/widget_accent"
                        android:textSize="9sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- Scanned Device Item 3 -->
                <LinearLayout
                    android:id="@+id/item_scanned_3_4x2"
                    android:layout_width="match_parent"
                    android:layout_height="22dp"
                    android:layout_marginTop="2dp"
                    android:background="@drawable/widget_item_bg"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="6dp">

                    <ImageView
                        android:layout_width="5dp"
                        android:layout_height="5dp"
                        android:src="@drawable/widget_status_dot_connected"
                        android:contentDescription="Online" />

                    <TextView
                        android:id="@+id/tv_scanned_name_3_4x2"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="5dp"
                        android:text="192.168.1.102:5555"
                        android:textColor="@color/widget_text_primary"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:singleLine="true"
                        android:ellipsize="end" />

                    <TextView
                        android:id="@+id/tv_scanned_action_3_4x2"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:minWidth="28dp"
                        android:gravity="center"
                        android:includeFontPadding="false"
                        android:text="连接"
                        android:textColor="@color/widget_accent"
                        android:textSize="9sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- Empty Hint (Shown when 0 devices found) -->
                <TextView
                    android:id="@+id/tv_scanned_empty_hint"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:gravity="center"
                    android:text="未发现开启 5555 端口的设备\n请确认被控端已开启无线调试"
                    android:textColor="@color/widget_text_secondary"
                    android:textSize="9sp"
                    android:visibility="gone" />

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1" />

                <!-- Bottom Rescan & Pair Action Row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <LinearLayout
                        android:id="@+id/btn_rescan_4x2"
                        android:layout_width="0dp"
                        android:layout_height="24dp"
                        android:layout_weight="1"
                        android:background="@drawable/widget_primary_btn_bg"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:orientation="horizontal"
                        android:paddingHorizontal="6dp">

                        <ImageView
                            android:layout_width="10dp"
                            android:layout_height="10dp"
                            android:src="@drawable/ic_widget_scan"
                            android:contentDescription="Rescan" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="3dp"
                            android:text="重新扫描"
                            android:textColor="@color/widget_white"
                            android:textSize="9sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/btn_pair_rescan_4x2"
                        android:layout_width="wrap_content"
                        android:layout_height="24dp"
                        android:layout_marginStart="6dp"
                        android:background="@drawable/widget_item_bg"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:orientation="horizontal"
                        android:paddingHorizontal="8dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="配对新设备"
                            android:textColor="@color/widget_text_secondary"
                            android:textSize="9sp" />
                    </LinearLayout>
                </LinearLayout>

            </LinearLayout>

        </LinearLayout>

        <!-- Case 2: Connected State - 4 Configurable Action Tiles in 2x2 Grid -->
        <LinearLayout
            android:id="@+id/layout_connected_actions_4x2"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:visibility="gone">

            <!-- Grid Row 1 (Tile 1 + Tile 2) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:orientation="horizontal">

            <!-- Tile 1 -->
            <LinearLayout
                android:id="@+id/btn_tile_1"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/widget_tile_bg"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="6dp">

                <ImageView
                    android:id="@+id/iv_tile_1"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:src="@drawable/ic_widget_power"
                    android:contentDescription="Tile 1" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="5dp"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tv_tile_title_1"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="锁屏"
                        android:textColor="@color/widget_text_primary"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tv_tile_subtitle_1"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="关屏休眠"
                        android:textColor="@color/widget_text_secondary"
                        android:textSize="8sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- Tile 2 -->
            <LinearLayout
                android:id="@+id/btn_tile_2"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:background="@drawable/widget_tile_bg"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="6dp">

                <ImageView
                    android:id="@+id/iv_tile_2"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:src="@drawable/ic_widget_screenshot"
                    android:contentDescription="Tile 2" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="5dp"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tv_tile_title_2"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="截屏"
                        android:textColor="@color/widget_text_primary"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tv_tile_subtitle_2"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="捕获画面"
                        android:textColor="@color/widget_text_secondary"
                        android:textSize="8sp" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- Grid Row 2 (Tile 3 + Tile 4) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="6dp"
            android:orientation="horizontal">

            <!-- Tile 3 -->
            <LinearLayout
                android:id="@+id/btn_tile_3"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/widget_tile_bg"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="6dp">

                <ImageView
                    android:id="@+id/iv_tile_3"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:src="@drawable/ic_widget_screen"
                    android:contentDescription="Tile 3" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="5dp"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tv_tile_title_3"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="投屏"
                        android:textColor="@color/widget_text_primary"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tv_tile_subtitle_3"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="启动镜像"
                        android:textColor="@color/widget_text_secondary"
                        android:textSize="8sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- Tile 4 -->
            <LinearLayout
                android:id="@+id/btn_tile_4"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:background="@drawable/widget_tile_bg"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="6dp">

                <ImageView
                    android:id="@+id/iv_tile_4"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:src="@drawable/ic_widget_home"
                    android:contentDescription="Tile 4" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="5dp"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tv_tile_title_4"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="主页"
                        android:textColor="@color/widget_text_primary"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tv_tile_subtitle_4"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="桌面直达"
                        android:textColor="@color/widget_text_secondary"
                        android:textSize="8sp" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>

</LinearLayout>
